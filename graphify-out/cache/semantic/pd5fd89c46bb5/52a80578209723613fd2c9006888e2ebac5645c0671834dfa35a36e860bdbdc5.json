d (NEVER violate)."}, {"id": "claude_main_router", "label": "main.py Router Layer", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_business_logic_layer", "label": "business_logic.py Layer", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_database_manager_layer", "label": "database_manager.py Layer", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_database_model_layer", "label": "database_model.py Pure Models", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No logic, no backrefs, no defaults, no auto-generated IDs; source of truth for schema kept deliberately simple."}, {"id": "claude_import_logic_module", "label": "import_logic.py Import Module", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_utils_helpers", "label": "utils.py Helpers (generate_uid, empty_to_none)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_backend_generated_ids", "label": "Backend-Generated UUIDs", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IDs created in business_logic.py via utils.generate_uid() and submitted to the DB rather than relying on auto-increment."}, {"id": "claude_integer_currency_amounts", "label": "Integer Currency Amounts", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All amounts stored as integers (no decimals) to avoid floating-point issues."}, {"id": "claude_pooled_mysql_database", "label": "PooledMySQLDatabase Connection Pooling", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connection pooling is critical for htmx performance (many small auto-save requests); pool size 10, recycle 3600s; initialized in database_manager.initialize_connection()."}, {"id": "claude_with_transaction_decorator", "label": "@with_transaction Decorator", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps every write for atomicity with automatic rollback; retries OperationalError up to 3 times, fails fast on ValueError/IntegrityError."}, {"id": "claude_retry_logic", "label": "Transient Failure Retry Logic", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_configuration_caching", "label": "Configuration Caching (5-minute)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-memory cache in business_logic.py reduces DB queries for config lookups; invalidated on config updates."}, {"id": "claude_log_query_time_decorator", "label": "@log_query_time Decorator", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logs slow queries over 1 second; can be disabled via ENABLE_QUERY_METRICS = False."}, {"id": "claude_mariadb", "label": "MariaDB", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_moneybags_db_config_json", "label": "moneybags_db_config.json", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds DB credentials so it is excluded from Git and Docker; persisted via volume mount and must exist before the container starts."}, {"id": "claude_split_configuration_storage", "label": "Split Configuration Storage", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App settings (currency) live in the MariaDB Configuration table, while connection settings live in a JSON file since the DB cannot store its own connection details."}, {"id": "claude_currency_format", "label": "Dynamic Currency Format (NOK/USD/EUR)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Symbol before amount with space and space as thousand separator, e.g. kr 1 234."}, {"id": "claude_no_inline_styles_scripts", "label": "No Inline Styles or Scripts Rule", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All JS in static/js/app.js and all CSS in static/css/custom.css keeps the codebase maintainable and easy to navigate."}, {"id": "claude_api_response_format", "label": "JSON API Response Envelope", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_error_handling", "label": "Valu